{
  "expo": {
    "name": "Fihiran Jesosy Mamonjy",
    "slug": "fihiran-jm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fihirana.png",
    "scheme": "fihiranjm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE00",
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundImage": "./assets/images/icon2.png",
        "monochromeImage": "./assets/images/icon2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kennyh2.x0.fihiranjm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fihirana.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#cc0000",
          "dark": {
            "backgroundColor": "#6e0000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
